---
import fs from "node:fs";
const base = import.meta.env.BASE_URL;
const dir = "public/img/shots";
const shots = fs.existsSync(dir) ? fs.readdirSync(dir).filter((f) => /\.(png|jpe?g|webp)$/.test(f)).sort() : [];
const caption = (f: string) => f.replace(/\.\w+$/, "").replace(/_/g, " ");
---

{
  shots.length > 0 && (
    <section class="gallery">
      <div class="wrap">
        <span class="ribbon">Screenshots</span>
        <h2>Postcards from the deep</h2>
        <div class="shots">
          {shots.map((f, i) => (
            <a class="shot reveal" style={`--d:${(i % 3) * 80}ms`} href={`${base}img/shots/${f}`} data-shot={caption(f)}>
              <img src={`${base}img/shots/${f}`} alt={caption(f)} loading="lazy" width="1920" height="1080" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 24px;
    margin-top: 48px;
  }

  .shot {
    display: block;
    border: 3px solid var(--abyss);
    box-shadow:
      0 0 0 3px var(--wood-2),
      0 0 0 6px var(--abyss);
    overflow: hidden;
  }

  .shot img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    image-rendering: pixelated;
    transition: transform 300ms;
  }

  .shot:hover img {
    transform: scale(1.06);
  }

  .shot:hover {
    box-shadow:
      0 0 0 3px var(--gold),
      0 0 0 6px var(--abyss);
  }
</style>
