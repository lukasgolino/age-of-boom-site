---
// Four ship cards: the hull turns to face the pointer (32 headings), team colour swatches, stats, and "Sink her".
import sprites from "../lib/sprites.json";
import { SHIPS, SHIP_MAX } from "../lib/data";

const base = import.meta.env.BASE_URL;
const TEAMS = [
  { id: "base", label: "Canvas", color: "#f0ead8" },
  { id: "red", label: "Red", color: "#c03a32" },
  { id: "blue", label: "Blue", color: "#4a84f2" },
  { id: "gold", label: "Gold", color: "#e8b42c" },
];
const S = sprites as Record<string, { w: number; h: number; sinking?: { frames: number; fps: number } }>;
const stat = (v: number, max: number) => `${Math.round((v / max) * 100)}%`;
---

<div class="yard">
  {
    SHIPS.map((s) => (
      <article class="ship panel reveal" data-ship={s.id} data-w={S[s.id].w} data-h={S[s.id].h} data-sink={S[s.id].sinking?.frames} data-sink-fps={S[s.id].sinking?.fps} data-base={base}>
        <div class="stage water">
          <canvas width="240" height="240" aria-label={`${s.name} sprite`} role="img" />
        </div>
        <div class="info">
          <h3>{s.name}</h3>
          <p class="role">{s.role}</p>
          <dl class="hud">
            <dt>Hull</dt>
            <dd><span style={`--v:${stat(s.hp, SHIP_MAX.hp)}`} /><b>{s.hp}</b></dd>
            <dt>Speed</dt>
            <dd><span style={`--v:${stat(s.speed, SHIP_MAX.speed)}`} /><b>{s.speed}</b></dd>
            <dt>Turn</dt>
            <dd><span style={`--v:${stat(s.turn, SHIP_MAX.turn)}`} /><b>{s.turn}/s</b></dd>
            <dt>Guns</dt>
            <dd><span style={`--v:${stat(s.guns, SHIP_MAX.guns)}`} /><b>{s.guns} a side</b></dd>
          </dl>
          <p class="extras">{s.extras}</p>
          <div class="controls">
            <div class="teams" role="group" aria-label="Team colour">
              {TEAMS.map((t, i) => (
                <button type="button" data-team={t.id} aria-label={t.label} aria-pressed={i === 0 ? "true" : "false"} style={`--c:${t.color}`} />
              ))}
            </div>
            <button type="button" class="sink hud">Sink her</button>
          </div>
        </div>
      </article>
    ))
  }
</div>

<script>
  const TAU = Math.PI * 2;
  const cache = new Map<string, HTMLImageElement>();
  function img(src: string): HTMLImageElement {
    let i = cache.get(src);
    if (!i) {
      i = new Image();
      i.src = src;
      cache.set(src, i);
    }
    return i;
  }

  const boomMeta = { w: 48, h: 48, n: 8, fps: 16 };

  for (const card of document.querySelectorAll<HTMLElement>(".ship")) {
    const id = card.dataset.ship!;
    const base = card.dataset.base!;
    const w = Number(card.dataset.w);
    const h = Number(card.dataset.h);
    const sinkN = Number(card.dataset.sink);
    const sinkFps = Number(card.dataset.sinkFps) || 2;
    const canvas = card.querySelector("canvas")!;
    const ctx = canvas.getContext("2d")!;
    ctx.imageSmoothingEnabled = false;
    const scale = Math.max(1, Math.floor(200 / Math.max(w, h)));
    let team = "base";
    let target = Math.random() * TAU;
    let angle = target;
    let pointer = false;
    let sinkAt = -1;
    const boom = img(`${base}sprites/explosion_big.png`);

    const strip = () => img(`${base}sprites/${id}_${team}.png`);
    const sinkStrip = () => img(`${base}sprites/${id}_${team}_sinking.png`);

    card.addEventListener("pointermove", (e) => {
      const r = canvas.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      if (dx * dx + dy * dy > 64) target = Math.atan2(-dy, dx);
      pointer = true;
    });
    card.addEventListener("pointerleave", () => (pointer = false));

    for (const b of card.querySelectorAll<HTMLButtonElement>("[data-team]")) {
      b.addEventListener("click", () => {
        team = b.dataset.team!;
        card.querySelectorAll("[data-team]").forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
      });
    }
    card.querySelector<HTMLButtonElement>(".sink")!.addEventListener("click", () => {
      if (sinkAt < 0) sinkAt = performance.now();
    });

    let last = performance.now();
    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

    function frame(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (visible) {
        if (!pointer) target += dt * 0.6;
        // Turn toward the target at a rate that loosely follows the ship's turn stat.
        let d = ((target - angle + Math.PI) % TAU + TAU) % TAU - Math.PI;
        angle += Math.sign(d) * Math.min(Math.abs(d), dt * 4);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const dw = w * scale;
        const dh = h * scale;
        const x = Math.round((canvas.width - dw) / 2);
        const y = Math.round((canvas.height - dh) / 2);
        if (sinkAt >= 0) {
          const t = (now - sinkAt) / 1000;
          const sinkDur = sinkN / sinkFps;
          if (t < sinkDur) {
            const f = Math.min(sinkN - 1, Math.floor(t * sinkFps));
            ctx.globalAlpha = 1 - Math.max(0, t - sinkDur + 0.6) / 0.6;
            ctx.drawImage(sinkStrip(), f * w, 0, w, h, x, y, dw, dh);
            ctx.globalAlpha = 1;
          }
          const bt = t - 0.15;
          if (bt >= 0 && bt < boomMeta.n / boomMeta.fps) {
            const f = Math.floor(bt * boomMeta.fps);
            const bs = scale + 1;
            ctx.drawImage(boom, f * boomMeta.w, 0, boomMeta.w, boomMeta.h, (canvas.width - boomMeta.w * bs) / 2, (canvas.height - boomMeta.h * bs) / 2, boomMeta.w * bs, boomMeta.h * bs);
          }
          if (t > sinkDur + 1.2) sinkAt = -1;
        } else {
          const idx = ((Math.round(angle / (TAU / 32)) % 32) + 32) % 32;
          ctx.drawImage(strip(), idx * w, 0, w, h, x, y + Math.round(Math.sin(now / 600) * 2), dw, dh);
        }
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
</script>

<style>
  .yard {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 500px), 1fr));
    gap: 40px;
    margin-top: 48px;
  }

  .ship {
    display: grid;
    grid-template-columns: 200px 1fr;
    color: var(--ink);
  }

  .stage {
    box-shadow: inset 0 0 0 3px rgb(0 0 0 / 0.4);
  }

  @media (max-width: 520px) {
    .ship {
      grid-template-columns: 1fr;
    }

    .info {
      padding: 18px 0 0;
    }
  }

  .stage {
    display: grid;
    place-items: center;
    min-height: 220px;
  }

  .stage canvas {
    width: 200px;
    height: 200px;
  }

  .info {
    padding: 4px 4px 4px 22px;
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .role,
  .extras {
    color: var(--ink-dim);
    font-size: 0.95rem;
  }

  .extras {
    font-size: 0.85rem;
    color: var(--muted);
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 12px;
    margin: 4px 0;
    font-size: 16px;
    line-height: 1;
    text-transform: uppercase;
    align-items: center;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  dd span {
    flex: 1;
    height: 8px;
    background: linear-gradient(to right, var(--gold) var(--v), var(--sea) var(--v));
    box-shadow: 0 0 0 2px var(--abyss);
  }

  dd b {
    font-weight: 400;
    min-width: 7ch;
    text-align: right;
  }

  .controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 6px;
  }

  .teams {
    display: flex;
    gap: 10px;
  }

  .teams button {
    width: 22px;
    height: 22px;
    border: 0;
    background: var(--c);
    box-shadow: 0 0 0 2px var(--abyss);
    cursor: pointer;
  }

  .teams button[aria-pressed="true"] {
    box-shadow:
      0 0 0 2px var(--abyss),
      0 0 0 5px var(--ink);
  }

  .sink {
    font-size: 16px;
    line-height: 1;
    text-transform: uppercase;
    background: var(--red);
    color: var(--ink);
    border: 0;
    padding: 9px 12px 8px;
    cursor: pointer;
    box-shadow:
      0 3px 0 #6b1a1c,
      0 0 0 2px var(--abyss);
  }

  .sink:active {
    transform: translateY(3px);
    box-shadow: 0 0 0 2px var(--abyss);
  }
</style>
