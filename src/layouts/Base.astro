---
import "@fontsource-variable/inter";
import "@fontsource/pixelify-sans/700.css";
import "@fontsource/pixelify-sans/400.css";
import "@fontsource/silkscreen/400.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const og = new URL(`${base}img/og.png`, Astro.site).href;
// Game UI images (tools/build_site_assets.py) as CSS variables, so CSS stays base-path independent.
const ui = (f: string) => `url(${base}sprites/ui/${f}.png)`;
const vars = [
  `--water-tile:url(${base}sprites/water.png)`,
  `--img-panel:${ui("panel_panel")}`,
  `--img-banner:${ui("banner_banner")}`,
  `--img-btn:${ui("button_normal")}`,
  `--img-btn-hover:${ui("button_hover")}`,
  `--img-btn-pressed:${ui("button_pressed")}`,
  `--img-bubble:${ui("bubble_bubble")}`,
].join(";");
const fontFace = `@font-face{font-family:"Boom Pixel";src:url(${base}fonts/boom-pixel.woff2) format("woff2");font-display:swap;}`;
---

<!doctype html>
<html lang="en" style={vars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060f1a" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="preload" href={`${base}fonts/boom-pixel.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:inline set:html={fontFace}></style>
  </head>
  <body>
    <slot />
    <script>
      // Reveal-on-scroll.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
