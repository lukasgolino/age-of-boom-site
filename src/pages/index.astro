---
import fs from "node:fs";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Gameplay from "../components/Gameplay.astro";
import Gallery from "../components/Gallery.astro";
import Sprite from "../components/Sprite.astro";
import Shipyard from "../components/Shipyard.astro";
import { AMMO, LINKS, MODES, PAGAN_URL, SEA, STEAM_URL } from "../lib/data";

const base = import.meta.env.BASE_URL;
const icon = (n: string) => `${base}sprites/ui/icon_${n}.png`;
const featLoop = (id: string) => fs.existsSync(`public/video/feat/${id}.mp4`);
// Sea section: the night and arctic loops, if recorded.
const seaLoops = [
  { loop: "loop_night", label: "Night action" },
  { loop: "loop_arctic", label: "Arctic waters" },
].filter((l) => fs.existsSync(`public/video/${l.loop}.mp4`));
---

<Base
  title="Age of Boom: pixel-art naval combat"
  description="Loud, top-down pixel-art naval combat. Out-sail other captains, get your broadside on them first, and sink them in a shower of splinters. Online deathmatch, co-op Last Stand and solo voyages. Coming to Steam."
>
  <Nav />
  <Hero />

  <main>
    <section class="pillars">
      <div class="wrap grid3">
        <article class="pillar reveal">
          <div class="art"><Sprite name="galleon" file="galleon_red" heading={2} scale={2} /></div>
          <h3>Positioning is aiming</h3>
          <p>No crosshair. Your guns fire from the beam, so the fight is won at the helm: wind, momentum and turn rate.</p>
        </article>
        <article class="pillar reveal" style="--d:100ms">
          <div class="art"><Sprite name="explosion_big" scale={2} /></div>
          <h3>Every hit is a show</h3>
          <p>Balls arc through the air, hulls splinter, sails tear, magazines go up and ships roll over and sink.</p>
        </article>
        <article class="pillar reveal" style="--d:200ms">
          <div class="art"><Sprite name="fire_large" scale={3} /><Sprite name="smoke_column" scale={3} delay={0.2} /></div>
          <h3>Readable at a glance</h3>
          <p>Class, damage, fire, torn sails and the loaded side all show on the ship itself. No guessing, just shooting.</p>
        </article>
      </div>
    </section>

    <Gameplay />

    <section id="fleet" class="fleet">
      <div class="wrap">
        <span class="ribbon">The fleet</span>
        <h2>From sloop to galleon</h2>
        <p class="lede">
          Sink and plunder for gold, then buy bigger hulls, more cannons and better shot. Point at a ship and it comes about to
          face you. Every class beats a fully upgraded ship of the class below, but a sloop still out-runs them all.
        </p>
        <Shipyard />
      </div>
    </section>

    <section class="arsenal">
      <div class="wrap">
        <span class="ribbon">The arsenal</span>
        <h2>Pick your poison</h2>
        <div class="ammo">
          {
            AMMO.map((a, i) => (
              <article class="panel reveal" style={`--d:${i * 80}ms`}>
                {featLoop(a.id) && (
                  <video class="feat" muted loop playsinline preload="none" data-lazy poster={`${base}video/feat/${a.id}.jpg`}>
                    <source data-src={`${base}video/feat/${a.id}.webm`} type="video/webm" />
                    <source data-src={`${base}video/feat/${a.id}.mp4`} type="video/mp4" />
                  </video>
                )}
                <img class="ammo-icon" src={icon(a.sprite)} alt="" width="16" height="16" />
                <h3>{a.name}</h3>
                <p class="hud stats">
                  DMG <b>{a.dmg}</b> RNG <b>{a.range}</b>
                </p>
                <p class="txt">{a.text}</p>
              </article>
            ))
          }
        </div>
        {
          featLoop("magazine") && (
            <article class="panel magazine reveal">
              <video class="feat" muted loop playsinline preload="none" data-lazy poster={`${base}video/feat/magazine.jpg`}>
                <source data-src={`${base}video/feat/magazine.webm`} type="video/webm" />
                <source data-src={`${base}video/feat/magazine.mp4`} type="video/mp4" />
              </video>
              <div class="mag-copy">
                <p class="hud tag">Powder magazine</p>
                <h3>And sometimes, boom.</h3>
                <p class="txt">
                  A ship sunk under fire can blow its magazine: a fireball, a shockwave and burning debris that hurt everything
                  nearby, and can set off the next ship's magazine too. Fire shot makes it far more likely.
                </p>
              </div>
            </article>
          )
        }
        <ul class="extras hud">
          <li><img class="icon" src={icon("cannon")} alt="" />Bow chasers</li>
          <li><img class="icon" src={icon("reload")} alt="" />Swivel guns</li>
          <li><img class="icon" src={icon("powder_keg")} alt="" />Powder kegs</li>
          <li><img class="icon" src={icon("repair")} alt="" />Repair kits</li>
          <li><img class="icon" src={icon("fair_wind")} alt="" />Fair winds</li>
          <li><img class="icon" src={icon("armour")} alt="" />Armour</li>
        </ul>
      </div>
    </section>

    <section id="modes" class="modes water">
      <div class="veil"></div>
      <div class="wrap">
        <span class="ribbon">Modes</span>
        <h2>Crew up or sail alone</h2>
        <div class="mode-grid">
          {
            MODES.map((m, i) => (
              <article class="panel reveal" style={`--d:${(i % 3) * 80}ms`}>
                <p class="hud tag">{m.tag}</p>
                <h3>{m.name}</h3>
                <p class="txt">{m.text}</p>
              </article>
            ))
          }
        </div>
        <div class="chat" aria-hidden="true">
          <span class="bubble hud">Your mother was a dinghy</span>
          <span class="bubble hud alt">Sunk by a sloop, how embarrassing</span>
        </div>
      </div>
    </section>

    <section class="sea">
      <div class="wrap">
        <span class="ribbon">The sea fights back</span>
        <h2>Wind, fog, night and ice</h2>
        <ul class="sea-list">
          {
            SEA.map((s, i) => (
              <li class="reveal" style={`--d:${(i % 3) * 80}ms`}>
                <h3>{s.name}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ul>
        <div class="sea-shots">
          {
            seaLoops.map((l, i) => (
              <figure class="sea-shot reveal" style={`--d:${i * 120}ms`}>
                <video muted loop playsinline preload="none" data-lazy poster={`${base}video/${l.loop}.jpg`}>
                  <source data-src={`${base}video/${l.loop}.webm`} type="video/webm" />
                  <source data-src={`${base}video/${l.loop}.mp4`} type="video/mp4" />
                </video>
                <figcaption class="hud">{l.label}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <Gallery />

    <section class="pagan">
      <div class="wrap pagan-inner">
        <div class="pagan-ships reveal" aria-hidden="true">
          <Sprite name="sloop" file="sloop_base" heading={4} scale={3} />
          <Sprite name="brig" file="brig_red" heading={4} scale={3} />
          <Sprite name="frigate" file="frigate_blue" heading={4} scale={3} />
          <Sprite name="galleon" file="galleon_gold" heading={4} scale={3} />
        </div>
        <div class="reveal">
          <span class="ribbon">Built with PAGAN</span>
          <h2>Every pixel, written as text</h2>
          <p class="lede">
            Every ship, explosion, wave and button in Age of Boom (and on this page) is drawn with{" "}
            <a href={PAGAN_URL}>PAGAN</a>, the Pixel Art Grammar And Notation: voxel hulls rendered in 32 headings, sails that
            furl and tear, team colours by palette swap, all built from text source files.
          </p>
        </div>
      </div>
    </section>

    <section class="final water">
      <div class="veil"></div>
      <div class="wrap final-inner">
        <Sprite name="galleon" file="galleon_blue_sinking" scale={4} />
        <h2>Feed the fishes.</h2>
        <p class="lede">Age of Boom is coming to PC. Get it on your wishlist and be first in the water.</p>
        <div class="ctas">
          {
            STEAM_URL ? (
              <a class="btn primary" href={STEAM_URL}>Wishlist on Steam</a>
            ) : (
              <span class="btn primary" aria-disabled="true">Coming to Steam</span>
            )
          }
          {LINKS.map((l) => <a class="btn" href={l.href}>{l.label}</a>)}
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-inner hud">
      <span>(c) {new Date().getFullYear()} Age of Boom</span>
      <span>Art made with <a href={PAGAN_URL}>PAGAN</a></span>
    </div>
  </footer>
</Base>

<style>
  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--abyss), rgb(6 15 26 / 0.55) 18%, rgb(6 15 26 / 0.55) 82%, var(--abyss));
    pointer-events: none;
  }

  .modes .wrap,
  .final .wrap {
    position: relative;
  }

  /* Pillars */
  .grid3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 56px;
  }

  .pillar {
    display: grid;
    gap: 14px;
    justify-items: start;
  }

  .pillar .art {
    height: 110px;
    display: flex;
    align-items: end;
    gap: 4px;
  }

  .pillar p,
  .txt,
  .sea-list p {
    color: var(--ink-dim);
  }

  /* Arsenal */
  .ammo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 36px;
    margin: 48px 0;
  }

  .ammo article,
  .mode-grid article {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 8px 4px;
  }

  .feat {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    image-rendering: pixelated;
    box-shadow: 0 0 0 3px var(--abyss);
    margin-bottom: 4px;
  }

  .feat + .ammo-icon {
    width: 48px;
    height: 48px;
    margin-top: -36px;
    margin-left: 8px;
    position: relative;
    filter: drop-shadow(2px 2px 0 var(--abyss));
  }

  .ammo-icon {
    width: 64px;
    height: 64px;
    image-rendering: pixelated;
  }

  .stats {
    color: var(--muted);
  }

  .stats b {
    color: var(--gold);
    font-weight: 400;
    margin-right: 12px;
  }

  .magazine {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    margin-bottom: 48px;
  }

  .mag-copy {
    display: grid;
    gap: 10px;
  }

  .mag-copy h3 {
    font-size: 2rem;
  }

  @media (max-width: 760px) {
    .magazine {
      grid-template-columns: 1fr;
    }
  }

  .extras {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .extras li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Modes */
  .mode-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 36px;
    margin-top: 48px;
  }

  .tag {
    color: var(--gold);
    text-transform: uppercase;
  }

  .chat {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 56px;
    justify-content: flex-end;
  }

  .bubble {
    color: #1d1208;
    border-style: solid;
    border-width: 12px;
    border-image: var(--img-bubble) 4 fill / 12px stretch;
    image-rendering: pixelated;
    padding: 0 6px;
    animation: float 3s ease-in-out infinite;
  }

  .bubble.alt {
    animation-delay: -1.5s;
  }

  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }

  /* Sea */
  .sea-list {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 36px 56px;
  }

  .sea-list li {
    border-left: 6px solid var(--sea-2);
    padding-left: 20px;
    display: grid;
    gap: 6px;
  }

  .sea-shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 32px;
    margin-top: 64px;
  }

  .sea-shot {
    display: block;
    position: relative;
    margin: 0;
    border: 3px solid var(--abyss);
    box-shadow:
      0 0 0 3px var(--wood-2),
      0 0 0 6px var(--abyss),
      10px 12px 0 6px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .sea-shot:nth-child(2) {
    margin-top: 48px;
  }

  .sea-shot video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .sea-shot figcaption {
    position: absolute;
    left: 12px;
    bottom: 10px;
    background: rgb(6 15 26 / 0.75);
    padding: 2px 10px;
    text-transform: uppercase;
  }

  /* PAGAN */
  .pagan-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 56px;
    align-items: center;
  }

  .pagan-ships {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 8px;
  }

  @media (max-width: 860px) {
    .pagan-inner {
      grid-template-columns: 1fr;
    }
  }

  /* Final */
  .final-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 8px;
  }

  .final .lede {
    margin-inline: auto;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 36px;
    justify-content: center;
  }

  .foot {
    border-top: 3px solid var(--deep);
  }

  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 28px;
    padding-bottom: 36px;
    color: var(--muted);
  }
</style>
